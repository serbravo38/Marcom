# =============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN / DESPLIEGUE - MARCOM CHILE (marcomchile.cl)
# =============================================================================

# Dominio y Enrutamiento Público
FRONTEND_URL=https://marcomchile.cl
PUBLIC_API_URL=https://marcomchile.cl
VITE_API_URL=/api/v1
FRONTEND_PORT=80
ENVIRONMENT=production
EXPOSE_RESET_TOKEN_IN_DEV=false
ALLOWED_ORIGINS=https://marcomchile.cl,https://www.marcomchile.cl,http://marcomchile.cl,http://www.marcomchile.cl,http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Configuración de la base de datos PostgreSQL
POSTGRES_USER=marcom_user
POSTGRES_PASSWORD=marcom_secure_password
POSTGRES_DB=marcom_db
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Configuración JWT
JWT_SECRET_KEY=supersecretkeyforauthservice_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de Correo SMTP (MXRouting)
SMTP_HOST=sunfire.mxrouting.net
SMTP_PORT=465
SMTP_USER=contacto@marcomchile.cl
SMTP_PASSWORD=tu_contraseña_aqui
SMTP_FROM=contacto@marcomchile.cl
SMTP_USE_SSL=true

# Configuración Pasarela de Pagos Flow (Chile)
# Para producción cambiar FLOW_URL=https://www.flow.cl/api y FLOW_SANDBOX=false
FLOW_API_KEY=tu_flow_api_key
FLOW_SECRET_KEY=tu_flow_secret_key
FLOW_SANDBOX=true
FLOW_URL=https://sandbox.flow.cl/api
