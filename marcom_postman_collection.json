{
  "info": {
    "_postman_id": "marcom-qa-suite-2026-v1",
    "name": "MARCOM - API Test Suite Modular (QA Master)",
    "description": "Colección completa de pruebas de QA para la plataforma MARCOM. Cubre microservicios de Auth, Inventario, Órdenes de Trabajo, Facturación (Flow / DTE) y API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Gateway & Infraestructura",
      "item": [
        {
          "name": "Health Check Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Estructura de respuesta contiene servicios registrados\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"healthy\");",
                  "    pm.expect(jsonData.services).to.have.property(\"auth-service\");",
                  "    pm.expect(jsonData.services).to.have.property(\"inventory-service\");",
                  "    pm.expect(jsonData.services).to.have.property(\"work-order-service\");",
                  "    pm.expect(jsonData.services).to.have.property(\"billing-service\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verificar Ruta Inexistente (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ruta-que-no-existe-xyz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ruta-que-no-existe-xyz"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 404 NOT FOUND\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
