      "item": [
        {
          "name": "Login Administrador Semilla",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@marcom.cl\",\n  \"clave\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/iniciar-sesion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "iniciar-sesion"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login semilla exitoso (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token JWT recibido\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"access_token\");",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.access_token);",
