          "name": "Crear Cotización Automática para Convenio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"convenio_id\": \"{{convenioId}}\",\n  \"ubicacion_id\": \"{{localId}}\",\n  \"fecha_solicitud_aprobacion\": \"2026-10-14T10:00:00Z\",\n  \"tipo_soporte\": \"ESTANDAR_CONVENIO\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{productoId}}\",\n      \"cantidad\": 2,\n      \"precio_unitario\": 450000.00\n    }\n  ],\n  \"notas\": \"Cotización formal para renovación de pantallas digitales\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cotizaciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cotizaciones"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cotización creada con cálculo automático (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var cot = pm.response.json();",
                  "pm.test(\"Cálculos financieros coherentes (IVA 19%)\", function () {",
                  "    pm.expect(cot.subtotal_neto).to.be.above(0);",
                  "    pm.expect(cot.monto_iva).to.be.above(0);",
                  "    pm.expect(cot.monto_total).to.be.above(cot.subtotal_neto);",
                  "});",
                  "pm.collectionVariables.set(\"cotizacionId\", cot.cotizacion_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Aprobar Cotización con Orden de Compra (OC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orden_compra_numero\": \"OC-CLIENTE-2026-{{$timestamp}}\",\n  \"orden_compra_adjunto\": \"https://marcom.cl/docs/oc/OC-2026-FIRMADA.pdf\",\n  \"notas\": \"Aprobación formal con Orden de Compra adjunta y crédito validado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cotizaciones/{{cotizacionId}}/aprobar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cotizaciones", "{{cotizacionId}}", "aprobar"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cotización aprobada y convertida a OT/Pedido (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.estado).to.eql(\"APROBADA\");",
                  "    pm.expect(data.pedido_id).to.not.be.null;",
                  "    pm.collectionVariables.set(\"pedidoId\", data.pedido_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Generar Documento Tributario Electrónico (DTE Factura SII)",
